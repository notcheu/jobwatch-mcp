{
  "name": "jobwatch-mcp",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Self-hosted read-only MCP orchestrator for job-search sources (Nx monorepo).",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:integration": "bash tests/integration/run.sh",
    "test:dashboard": "node tests/dashboard/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "catalog:gen": "UPDATE_CATALOG=1 nx run-many -t test -p 'tag:type:adapter' --skip-nx-cache",
    "new:adapter": "node tools/new-module/index.mjs adapter",
    "new:utility": "node tools/new-module/index.mjs utility",
    "dev": "node tools/dev.mjs",
    "dev:dashboard": "node tools/dev-dashboard.mjs",
    "start": "node tools/start.mjs",
    "jobwatch": "npm run -s build -w @jobwatch/cli && node tools/jobwatch.mjs",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nx/eslint-plugin": "23.2.1",
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "nx": "23.2.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "nx": false,
    "fsevents": false,
    "esbuild": false
  }
}
