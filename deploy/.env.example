# Copy to deploy/.env (gitignored; chmod 600). Contains secrets once filled in: never commit it.
JW_BASE_URL=https://mcp.example.com
JW_BIND=127.0.0.1        # use the host's LAN IP if Nginx runs on another machine or in a container
# Host port Nginx proxies to (not 8080: it is commonly taken). The container-internal ports stay 8080.
JW_HOST_PORT=18931
JW_REGISTRY=registry.example.com   # same value as the REGISTRY_URL GitHub secret
JW_TAG=latest
JW_WATCHTOWER_IMAGE=<watchtower-image>@sha256:<pinned>
# JW_FRONT_IMAGE=ghcr.io/babs/mcp-auth-proxy@sha256:<pinned>   # default: tag 1.4.1 (image tags have NO "v" prefix); pin by digest after S1
# JW_REDIS_IMAGE=redis@sha256:<pinned>

# OAuth front (babs/mcp-auth-proxy), Google as the only identity provider (see docs/plans/10-deployment.md)
OIDC_CLIENT_ID=<google-oauth-client-id>.apps.googleusercontent.com
OIDC_CLIENT_SECRET=<google-oauth-client-secret>
TOKEN_SIGNING_SECRET=<openssl rand -base64 48>
JW_NGINX_CIDR=172.17.0.1/32        # address of Nginx as seen by the front: the Docker gateway if Nginx runs on the host, else its LAN IP/32

# Docker socket mounted into the router and Watchtower. Empty = $XDG_RUNTIME_DIR/docker.sock (Linux rootless Docker).
# macOS / Docker Desktop: /var/run/docker.sock
JW_DOCKER_SOCKET=

# Stored job postings (docs/plans/07-adapter-linkedin.md): days a job is kept after it was last seen (read, or still listed in a search), then evicted (1-3650).
# JW_JOB_RETENTION_DAYS=30

# Where LinkedIn searches look when a call gives no `geo` (a place name such as "Berlin, Germany", or a LinkedIn geoId). No place is built in.
# JW_DEFAULT_LOCATION=
# Names for the LinkedIn geoIds you use often: home=104246759,europe=91000000
# JW_LINKEDIN_GEO_ALIASES=
# `jobwatch linkedin-geo "Berlin" --save home` does the same from the command line and needs no restart (enable the linkedin-geo adapter).

# Browser (docs/plans/05-browser-runtime.md). The language list is copied from navigator.languages of your everyday browser (G8).
# JW_BROWSER_IMAGE=registry.example.com/jobwatch-browser:latest
# JW_BROWSER_LANG=fr-FR
# Most tabs the browser may have open at once (default 3; 1 = a single tab). The memory cap does not change; see docs/plans/06-memory-and-lifecycle-policy.md.
# JW_BROWSER_MAX_TABS=3
# JW_BROWSER_ACCEPT_LANGS=fr-FR,en-GB,en-US

# Operator dashboard (docs/plans/17-dashboard.md): closed until `jobwatch dashboard start`. It signs in with Google. By default it uses the
# connector's OIDC_CLIENT_ID and OIDC_CLIENT_SECRET above (add https://<domain>/dashboard/auth/callback to that client's redirect URIs);
# set these two only to give the dashboard a client of its own.
# JW_DASHBOARD_OIDC_CLIENT_ID=
# JW_DASHBOARD_OIDC_CLIENT_SECRET=
# JW_DASHBOARD_BIND=127.0.0.1       # where Nginx reaches it, like JW_BIND
# JW_DASHBOARD_HOST_PORT=18933
# JW_DASHBOARD_IDLE_S=1800          # it closes after this many seconds without a request

# Optional observability (see docs/plans/10-deployment.md)
JW_METRICS_ENABLED=false
JW_METRICS_BIND=127.0.0.1   # LAN IP reachable by your Prometheus
JW_METRICS_PORT=9464
