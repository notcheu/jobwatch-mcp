# The `.env` file that sits next to compose.yml (Docker Compose reads it by itself). Copy this file, keep what you need and `chmod 600 .env`.
# It holds secrets once filled in: never commit it. The OAuth front and the router both get the whole file as their environment.
# Every variable that has a default is set to it here; the commented ones have none (unset). See docs/environment-variables.md. Values are expanded by Compose: `${PORT}` is the value of PORT.
# Not meant for Compose, so not listed here: LISTEN_HOST, DATA_DIR, DB_PATH (compose.yml fixes them), ADAPTERS and UTILITIES (enable modules
# with the CLI), FRONT_SHARED_SECRET, DASHBOARD_STATIC_DIR and AUTH (see .env.local). Browser variables that compose.yml fixes, or that only
# apply to a run on your own machine, are listed under Browser, disabled and marked.


#################
#    General    #
#################

# Public URL of the server. Default: the server on your own machine. (e.g. https://mcp.example.com)
BASE_URL=http://127.0.0.1:18931
# PORT on which the router is running
PORT=18931
# Days a stored job is kept after it was last seen (1-3650).
JOB_RETENTION_DAYS=30
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Characters per token, for the estimate of what a result costs Claude (1-10).
TOKEN_CHARS_PER_TOKEN=3.5


#################
#    Modules    #
#################

# LinkedIn

# Where LinkedIn searches look when a call gives no `geo`: a place name or a LinkedIn geoId. No place is built in.
# LINKEDIN_DEFAULT_LOCATION=
# Names for the LinkedIn geoIds you use often: home=104246759,europe=91000000
# LINKEDIN_GEO_ALIASES=


###############
#    OAuth    #
###############

# The OAuth front (babs/mcp-auth-proxy), only for the public deployment: docs/oauth.md. All of these are required by the front.
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=<google-oauth-client-id>.apps.googleusercontent.com
OIDC_CLIENT_SECRET=<google-oauth-client-secret>
# openssl rand -base64 48 (keep it identical across restarts)
TOKEN_SIGNING_SECRET=<openssl rand -base64 48>
# Address of your reverse proxy as the front sees it: the Docker gateway if it runs on the host, else its LAN IP followed by /32.
TRUSTED_PROXY_CIDRS=172.17.0.1/32


#################
#    Browser    #
#################

# Where the browser comes from. In Docker Compose it is a container the router spawns; the settings below marked "not for Compose" are
# disabled on purpose: they only make sense for a router running on your own machine (see .env.local).
# Container runtime (only `docker` is implemented).
BROWSER_RUNTIME=docker
# Internal Docker network of the browsers: compose.yml creates it under this name and the router attaches the browsers to it.
BROWSER_NETWORK=jobwatch-browsers
# Where the router finds the Docker socket inside its container: compose.yml mounts it at /var/run/docker.sock, so leave this as it is.
DOCKER_HOST=unix:///var/run/docker.sock
# Browser image the router spawns.
BROWSER_IMAGE=jobwatch-browser:latest
# Absolute path of the Chrome seccomp profile as the docker CLI sees it; unset = Docker's default profile.
# BROWSER_SECCOMP=
# Browser profiles are Docker volumes named <prefix><platform>.
BROWSER_PROFILE_VOLUME_PREFIX=jw-profile-
# Startup check that the container's Chrome looks like a normal one: enforce | warn | off
BROWSER_FINGERPRINT=enforce
# Soft and hard memory marks of the container, in MB (high must be lower than max).
BROWSER_MEM_HIGH_MB=1200
BROWSER_MEM_MAX_MB=1500
# Seconds the browser stays up after its last call (10-3600).
BROWSER_IDLE_TTL_S=120
# A browser older than this many seconds is recycled at the next call (60-86400).
BROWSER_MAX_LIFETIME_S=1800
# Seconds a call waits for the single browser before failing with `busy` (1-600).
BROWSER_QUEUE_TIMEOUT_S=60
# Not for Compose: a Chrome started or attached on the machine of the router (loopback only), so not one inside the router's container.
# Start a visible Chrome with a profile per platform in <DATA_DIR>/browser-profiles/ (BROWSER_LOCAL_CHROME_PATH: its executable if not found).
BROWSER_LOCAL_CHROME=false
# BROWSER_LOCAL_CHROME_PATH=
# Attach to a Chrome that is already running (a loopback DevTools URL). Wins over BROWSER_LOCAL_CHROME.
# BROWSER_CDP_URL=http://127.0.0.1:9222
# Language of the browser, and the Accept-Language list copied from navigator.languages of your everyday browser.
BROWSER_LANG=fr-FR
# BROWSER_ACCEPT_LANGS=fr-FR,en-GB,en-US
# Most tabs open at once; 1 = a single tab. The memory cap does not change.
BROWSER_MAX_TABS=3


############################
#    Operator dashboard    #
############################

# Closed until `jobwatch dashboard start`. Its port is published on the host (see compose.yml); keep it in sync with your reverse proxy.
DASHBOARD_PORT=18933
# By default it signs in with the OAuth client above. Add https://<your domain>/dashboard/auth/callback to that client's redirect URIs,
# or give the dashboard a client of its own:
# DASHBOARD_OIDC_CLIENT_ID=
# DASHBOARD_OIDC_CLIENT_SECRET=
# DASHBOARD_OIDC_ISSUER=
# Where the operator opens it. Default: <BASE_URL origin>/dashboard/
# DASHBOARD_URL=
# Seconds without a request before it closes itself (60-86400).
DASHBOARD_IDLE_S=1800
# A session never lasts longer than this many seconds (300-604800).
DASHBOARD_SESSION_MAX_S=28800
# A change is accepted without signing in again for this many seconds after a sign-in; 0 = every change signs in again.
DASHBOARD_WRITE_WINDOW_S=600
# Calls kept in memory for the dashboard (100-20000).
DASHBOARD_CALL_BUFFER=2000


#################
#    Metrics    #
#################

# true: Prometheus /metrics on its own port, never on the MCP port. The port is published on the host (see compose.yml).
METRICS_ENABLED=false
METRICS_PORT=9464
