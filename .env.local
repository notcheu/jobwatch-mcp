# Read by `npm run dev` only: the server runs straight from the sources, without Docker and without OAuth. Committed: keep it free of secrets.
# Never expose this port: JW_AUTH=none is accepted only on a loopback address.
JW_AUTH=none
JW_BASE_URL=http://127.0.0.1:18931
JW_LISTEN_HOST=127.0.0.1
JW_PORT=18931
# JW_DATA_DIR=./.data                          # default; the folder is created for you
# Modules without a browser need no Docker. linkedin, apec and wttj spawn a Chrome container (needs Docker and JW_BROWSER_IMAGE),
# unless you use your own Chrome instead (see the README). `npm run dev` and `npm run start` use a local Chrome by default:
JW_LOCAL_CHROME=true                           # start a Chrome on this machine (set to false to use the Docker image)
# JW_LOCAL_CHROME_PATH=                        # Chrome executable, if it is not found
# JW_CDP_URL=http://127.0.0.1:9222             # attach to a Chrome started with --remote-debugging-port=9222 and its own --user-data-dir; wins over JW_LOCAL_CHROME
JW_ADAPTERS=teamtailor,greenhouse,lever,ashby
JW_UTILITIES=ats-discovery
# JW_LOG_LEVEL=debug
