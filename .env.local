# Read by `npm run dev` and `npm run start` (`start` also reads `.env`, which wins; a variable set in the shell wins over both).
# The server runs straight from the sources, without Docker and without OAuth. Committed: keep it free of secrets.
# Unset (commented) variables have a default; see docs/environment-variables.md.

#################
#    General    #
#################
# Never expose this port: AUTH=none is accepted only on a loopback address.
AUTH=none
BASE_URL=http://127.0.0.1:18931
LISTEN_HOST=127.0.0.1
PORT=18931
# Database, enabled modules and browser profiles. The folder is created for you.
# DATA_DIR=./.data
# DB_PATH=
# Days a stored job is kept after it was last seen (1-3650).
# JOB_RETENTION_DAYS=30
# Days a call is kept in the call log, with its parameters, before it is deleted (the log rotation, 1-3650).
# CALL_LOG_RETENTION_DAYS=30
# Adapters written on the dashboard (Tools, Custom adapters). `process` runs their scripts in a bare Node process (no network, no files,
# but no container or memory cap): fine here, never on a router that is reachable (docker is the default and needs the Docker socket).
# CUSTOM_ADAPTERS=on
# CUSTOM_ADAPTERS_SANDBOX=process
# CUSTOM_ADAPTERS_IMAGE=node:26-bookworm-slim
# trace | debug | info | warn | error | fatal
# LOG_LEVEL=info
# Container runtime for the browser; only `docker` is implemented.
# BROWSER_RUNTIME=docker
# Characters per token, for the estimate of what a result costs Claude (1-10).
# TOKEN_CHARS_PER_TOKEN=3.5

#################
#    Modules    #
#################
# Pins the lists (the CLI can no longer change them). Without them, `jobwatch adapters enable` decides; nothing is enabled by default.
ADAPTERS=teamtailor,greenhouse,lever,ashby
UTILITIES=ats-discovery
# Where LinkedIn searches look when a call gives no `geo`: a place name or a LinkedIn geoId. No place is built in.
# LINKEDIN_DEFAULT_LOCATION=
# Names for the LinkedIn geoIds you use often: home=104246759,europe=91000000
# LINKEDIN_GEO_ALIASES=

###############
#    OAuth    #
###############
# Not used without the OAuth front (docs/oauth.md). Only the dashboard sign-in applies, and only with AUTH=front.
# FRONT_SHARED_SECRET=
# OIDC_ISSUER_URL=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# DASHBOARD_OIDC_CLIENT_ID=
# DASHBOARD_OIDC_CLIENT_SECRET=
# DASHBOARD_OIDC_ISSUER=https://accounts.google.com

#################
#    Browser    #
#################
# Which Chrome the browser modules (linkedin, apec, wttj) use. In order of precedence:
# 1. Attach to a Chrome that is already running (loopback DevTools URL; start it with --remote-debugging-port and its own --user-data-dir).
# BROWSER_CDP_URL=http://127.0.0.1:9222
# 2. Start a visible Chrome on this machine, with a profile per platform in <DATA_DIR>/browser-profiles/.
BROWSER_LOCAL_CHROME=true
# BROWSER_LOCAL_CHROME_PATH=
# 3. A container (set BROWSER_LOCAL_CHROME=false; needs Docker and the browser image).
# BROWSER_IMAGE=localhost/jobwatch-browser:1
# BROWSER_NETWORK=jobwatch-browsers
# BROWSER_SECCOMP=
# BROWSER_PROFILE_VOLUME_PREFIX=jw-profile-
# BROWSER_FINGERPRINT=enforce
# BROWSER_MEM_HIGH_MB=1200
# BROWSER_MEM_MAX_MB=1500
# BROWSER_IDLE_TTL_S=120
# BROWSER_MAX_LIFETIME_S=1800
# BROWSER_QUEUE_TIMEOUT_S=60
# Language of the browser container and its Accept-Language list (a local or attached Chrome keeps its own).
# BROWSER_LANG=fr-FR
# BROWSER_ACCEPT_LANGS=fr-FR,en-GB,en-US
# Most tabs open at once; 1 = a single tab.
# BROWSER_MAX_TABS=3

############################
#    Operator dashboard    #
############################
# Closed until `npm run jobwatch -- dashboard start`; with AUTH=none it is on its own loopback port (default 8090), at
# http://127.0.0.1:8090/dashboard/. The interface needs `npm run build` first (DASHBOARD_STATIC_DIR is then set for you).
# DASHBOARD_PORT=8090
# DASHBOARD_URL=
# DASHBOARD_STATIC_DIR=
# DASHBOARD_IDLE_S=1800
# DASHBOARD_SESSION_MAX_S=28800
# DASHBOARD_WRITE_WINDOW_S=600
# DASHBOARD_CALL_BUFFER=2000

#################
#    Metrics    #
#################
# METRICS_ENABLED=false
# METRICS_PORT=9464
